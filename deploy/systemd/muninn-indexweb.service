[Unit]
Description=Muninn web viewer (0.0.0.0:7415)
After=muninn-indexd.service
Wants=muninn-indexd.service

[Service]
EnvironmentFile=%h/.config/muninn/index.env
EnvironmentFile=%h/.config/muninn/indexweb.env
ExecStart=%h/.local/bin/muninn-indexweb
Restart=always
RestartSec=5
Nice=10
IOSchedulingClass=idle
MemoryMax=256M
TasksMax=64
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=default.target
