# ~/.config/muninn/index.env (mode 0600). Read by every Muninn service.

# Postgres 16+ with pgvector. The services create their tables and policies on start.
MUNINN_PG_URL=postgres://muninn:CHANGE_ME@127.0.0.1:5432/muninn

# OpenAI-compatible model server (llama.cpp llama-server, vLLM, ...):
#   /v1/embeddings with a 768-dimension model (embeddinggemma-300m by default)
#   /v1/rerank (a cross-encoder such as bge-reranker-v2-m3)
#   /v1/chat/completions (optional; LLM query expansion, opt-in per search)
MUNINN_EMBED_URL=http://127.0.0.1:8084
MUNINN_RERANK_URL=http://127.0.0.1:8085
#MUNINN_CHAT_URL=http://127.0.0.1:8086
#MUNINN_CHAT_MODEL=gemma-3-4b-it
# Bearer token for the model server, if it wants one.
#MUNINN_LLAMA_API_KEY=

# Bare repo mirrors to index. Push or fetch into them; the reference-transaction hook reindexes.
MUNINN_REPOS_DIR=/home/YOU/.local/share/muninn/repos
# Index only these mirrors (default: all).
#MUNINN_INDEX_ONLY=api,web

# Secrets, both required (indexd refuses to start without them): generate each with
#   openssl rand -hex 32
# Values run to the end of the line (systemd does not strip trailing comments), so comments go above.
# HMAC key for /webhook/push (the mirror hooks and backfill.sh sign with it):
MUNINN_WEBHOOK_SECRET=CHANGE_ME
# Bearer for indexd's HTTP API (mcp, indexweb and the CLI use it):
MUNINN_INDEXD_TOKEN=CHANGE_ME

# Agent identities and their scopes (hashes only; see README.md). Must exist before install.sh
# starts the services: memoryd and mcp refuse to start without it.
MUNINN_TOKENS_FILE=/home/YOU/.config/muninn/tokens.json
# Without a tokens file (or MUNINN_MCP_TOKEN) muninn-mcp refuses to start; this opts in to serving
# the index tools to anyone who can reach it instead.
#MUNINN_MCP_ANONYMOUS=1

# Binds (loopback by default; put a TLS proxy in front to serve other machines)
#MUNINN_INDEXD_BIND=127.0.0.1:7410
#MUNINN_MCP_BIND=127.0.0.1:7411
#MUNINN_MEMORYD_BIND=127.0.0.1:7412

# SCIP symbols. indexd indexes small repos itself after a push; rust-analyzer is looked up here,
# then with rustup, then on PATH (a systemd user service often has no ~/.cargo/bin on PATH).
#MUNINN_RUST_ANALYZER=/home/YOU/.rustup/toolchains/1.98.1-x86_64-unknown-linux-gnu/bin/rust-analyzer
#MUNINN_SCIP_TYPESCRIPT=/usr/bin/scip-typescript
# Built by muninn-scip.timer instead; indexd skips them:
#MUNINN_SCIP_REPOS=big-workspace

# Uncommitted edits (muninn-watch): repo=/path/to/checkout,...
#MUNINN_WATCH=api=/home/YOU/src/api
